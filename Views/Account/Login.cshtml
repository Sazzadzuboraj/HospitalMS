@model HospitalMS.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — HospitalMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            var t = localStorage.getItem('hms-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
</head>
<body>
<div class="login-page">
    <div class="login-card">
        <div class="login-logo"><i class="bi bi-heart-pulse-fill"></i></div>
        <h1 class="login-title">HospitalMS</h1>
        <p class="login-subtitle">Enterprise Hospital Management System</p>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="@(ViewData.ModelState.ErrorCount == 0 ? "display:none" : "")"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="you@hospital.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger" style="font-size:.8rem"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:.8rem"></span>
            </div>

            <div class="mb-4 d-flex align-items-center gap-2">
                <input asp-for="RememberMe" type="checkbox" id="remember" style="accent-color:var(--brand-primary)" />
                <label for="remember" style="font-size:.85rem;color:var(--text-secondary);cursor:pointer">Remember me</label>
            </div>

            <button type="submit" class="btn btn-primary w-100" style="padding:12px;font-size:1rem">
                <i class="bi bi-box-arrow-in-right"></i> Sign In
            </button>
        </form>

        <div class="demo-credentials">
            <strong>Demo Accounts</strong><br />
            Admin: <code>admin@hospitalms.com</code> / <code>Admin@12345</code><br />
            Doctor: <code>dr.smith@hospitalms.com</code> / <code>Doctor@123</code><br />
            Reception: <code>reception@hospitalms.com</code> / <code>Reception@123</code>
        </div>
    </div>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
