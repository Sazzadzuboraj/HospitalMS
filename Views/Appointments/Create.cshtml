@model Appointment
@{
    ViewData["Title"] = "Schedule Appointment";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-calendar-plus me-2"></i>New Appointment</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="PatientId" class="form-label">Patient *</label>
                        <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-select">
                            <option value="">Select patient…</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DoctorId" class="form-label">Doctor *</label>
                        <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select">
                            <option value="">Select doctor…</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AppointmentDate" class="form-label">Date *</label>
                            <input asp-for="AppointmentDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TimeSlot" class="form-label">Time Slot *</label>
                            <select asp-for="TimeSlot" asp-items="ViewBag.TimeSlots" class="form-select">
                                <option value="">Select slot…</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label">Reason</label>
                        <input asp-for="Reason" class="form-control" placeholder="e.g. General checkup" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Schedule</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
