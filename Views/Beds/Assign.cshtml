@model BedAssignment
@{
    ViewData["Title"] = "Assign Bed";
    var bed = (Bed)ViewBag.Bed;
}

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-person-plus me-2"></i>Assign Patient to @bed.BedNumber</h3>
            </div>
            <div class="card-body">
                <div class="mb-3 p-3" style="background:var(--bg-muted);border-radius:var(--border-radius-sm)">
                    <div class="fw-semibold">@bed.BedNumber — @bed.WardName</div>
                    <div class="text-muted" style="font-size:.85rem">Floor @bed.Floor · @bed.WardType · @bed.DailyRate.ToString("C")/day</div>
                </div>
                <form asp-action="Assign" method="post">
                    <input type="hidden" asp-for="BedId" />
                    <div class="mb-3">
                        <label asp-for="PatientId" class="form-label">Patient *</label>
                        <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-select">
                            <option value="">Select patient…</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AdmittedAt" class="form-label">Admission Date/Time</label>
                        <input asp-for="AdmittedAt" type="datetime-local" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="AdmissionNotes" class="form-label">Notes</label>
                        <textarea asp-for="AdmissionNotes" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Confirm Assignment</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
