@model Patient
@{
    ViewData["Title"] = "Patient Details";
    var age = DateTime.Today.Year - Model.DateOfBirth.Year;
    if (Model.DateOfBirth.Date > DateTime.Today.AddYears(-age)) age--;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 style="font-family:var(--font-display);font-weight:700;margin:0">@Model.FullName</h2>
        <code style="color:var(--brand-primary)">@Model.PatientCode</code>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Demographics</h3></div>
            <div class="card-body">
                <table style="width:100%;font-size:.9rem">
                    <tr><td class="text-muted" style="padding:6px 0;width:40%">Gender</td><td class="fw-semibold">@Model.Gender</td></tr>
                    <tr><td class="text-muted" style="padding:6px 0">Age</td><td class="fw-semibold">@age years</td></tr>
                    <tr><td class="text-muted" style="padding:6px 0">DOB</td><td>@Model.DateOfBirth.ToString("MMM dd, yyyy")</td></tr>
                    <tr><td class="text-muted" style="padding:6px 0">Blood</td><td><span class="badge badge-info">@(Model.BloodGroup ?? "—")</span></td></tr>
                    <tr><td class="text-muted" style="padding:6px 0">Phone</td><td>@(Model.Phone ?? "—")</td></tr>
                    <tr><td class="text-muted" style="padding:6px 0">Email</td><td>@(Model.Email ?? "—")</td></tr>
                    <tr><td class="text-muted" style="padding:6px 0">Address</td><td>@(Model.Address ?? "—")</td></tr>
                    <tr><td class="text-muted" style="padding:6px 0">Emergency</td><td>@(Model.EmergencyContact ?? "—") @(Model.EmergencyPhone)</td></tr>
                    <tr><td class="text-muted" style="padding:6px 0">Status</td>
                        <td>@(Model.IsActive ? Html.Raw("<span class='badge badge-success badge-dot'>Active</span>") : Html.Raw("<span class='badge badge-secondary'>Inactive</span>"))</td>
                    </tr>
                </table>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.MedicalHistory) || !string.IsNullOrEmpty(Model.Allergies))
        {
            <div class="card mt-3">
                <div class="card-header"><h3 class="card-title">Clinical Notes</h3></div>
                <div class="card-body" style="font-size:.9rem">
                    @if (!string.IsNullOrEmpty(Model.MedicalHistory))
                    {
                        <div class="mb-2"><strong>History:</strong> @Model.MedicalHistory</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Allergies))
                    {
                        <div><strong>Allergies:</strong> <span class="badge badge-danger">@Model.Allergies</span></div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Appointments</h3></div>
            <div class="card-body p-0">
                @if (Model.Appointments.Any())
                {
                    <div class="table-wrapper">
                        <table class="table">
                            <thead><tr><th>Date</th><th>Doctor</th><th>Reason</th><th>Status</th></tr></thead>
                            <tbody>
                            @foreach (var a in Model.Appointments.OrderByDescending(x => x.AppointmentDate))
                            {
                                <tr>
                                    <td>@a.AppointmentDate.ToString("MMM dd, yyyy") <small class="text-muted">@a.TimeSlot</small></td>
                                    <td>@a.Doctor?.FullName</td>
                                    <td>@(a.Reason ?? "—")</td>
                                    <td><span class="badge badge-info">@a.Status</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else { <div class="empty-state" style="padding:24px"><p>No appointments</p></div> }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">Billing History</h3></div>
            <div class="card-body p-0">
                @if (Model.Billings.Any())
                {
                    <div class="table-wrapper">
                        <table class="table">
                            <thead><tr><th>Invoice</th><th>Total</th><th>Paid</th><th>Status</th></tr></thead>
                            <tbody>
                            @foreach (var b in Model.Billings.OrderByDescending(x => x.CreatedAt))
                            {
                                <tr>
                                    <td><a asp-controller="Billing" asp-action="Details" asp-route-id="@b.Id">@b.InvoiceNumber</a></td>
                                    <td>@b.TotalAmount.ToString("C")</td>
                                    <td>@b.AmountPaid.ToString("C")</td>
                                    <td><span class="badge badge-@(b.Status == PaymentStatus.Paid ? "success" : b.Status == PaymentStatus.Partial ? "warning" : "danger")">@b.Status</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else { <div class="empty-state" style="padding:24px"><p>No bills</p></div> }
            </div>
        </div>
    </div>
</div>
