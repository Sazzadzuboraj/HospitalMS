@model HospitalMS.Controllers.CreateUserViewModel
@{
    ViewData["Title"] = "Add Staff Member";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-person-plus-fill me-2"></i>New Staff Account</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="@(ViewData.ModelState.ErrorCount == 0 ? "display:none" : "")"></div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name *</label>
                        <input asp-for="FullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email *</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmployeeId" class="form-label">Employee ID *</label>
                        <input asp-for="EmployeeId" class="form-control" placeholder="EMP-XXX" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Department" class="form-label">Department</label>
                            <input asp-for="Department" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Specialization" class="form-label">Specialization</label>
                            <input asp-for="Specialization" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">Role *</label>
                        <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select">
                            <option value="">Select role…</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Temporary Password *</label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <small class="text-muted">Min 8 chars, upper, lower, digit</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create Account</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
