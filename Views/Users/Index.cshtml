@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Staff & Users";
    var userRoles = (Dictionary<string, string>)ViewBag.UserRoles;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <span class="text-muted">@Model.Count() staff members</span>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Add Staff</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Employee ID</th>
                        <th>Department</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.FullName</td>
                        <td>@u.Email</td>
                        <td><code>@(u.EmployeeId ?? "—")</code></td>
                        <td>@(u.Department ?? "—")</td>
                        <td><span class="badge badge-primary">@(userRoles.GetValueOrDefault(u.Id, "—"))</span></td>
                        <td>
                            @if (u.IsActive)
                            { <span class="badge badge-success badge-dot">Active</span> }
                            else
                            { <span class="badge badge-secondary">Inactive</span> }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleActive" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="btn-icon-sm" title="@(u.IsActive ? "Deactivate" : "Activate")"
                                        data-confirm="@(u.IsActive ? "Deactivate this user?" : "Activate this user?")">
                                    <i class="bi bi-@(u.IsActive ? "toggle-on" : "toggle-off")"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
